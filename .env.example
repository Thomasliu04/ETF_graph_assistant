ETF_AI_API_KEY=replace_with_your_api_key

# 厂商预设（见 scripts/providers.py）：
#   aliyun | dashscope | deepseek | zhipu | moonshot | siliconflow | volcengine | openai | custom
# 别名：qwen/tongyi→dashscope，glm→zhipu，kimi→moonshot，doubao→volcengine
ETF_AI_API_TYPE=aliyun
ETF_AI_MODEL_NAME=qwen3.7-plus

# 可选：覆盖该厂商默认 base（不要带 /chat/completions）
# 留空则使用预设；custom 时必填
ETF_AI_BASE_URL=

ETF_AI_REQUEST_TIMEOUT=300
ETF_AI_REQUEST_RETRIES=2
# 兼容旧配置：保留即可；新 loop 以 MAX_REVISE_ROUNDS 控制局部改写次数
ETF_AI_REPORT_RETRIES=2
ETF_AI_PASS_SCORE=80
ETF_AI_MAX_REVISE_ROUNDS=2
ETF_AI_MIN_SCORE_GAIN=5

# ---- 换厂商示例（改 TYPE + MODEL + KEY，BASE 一般可留空）----
# DeepSeek:
#   ETF_AI_API_TYPE=deepseek
#   ETF_AI_MODEL_NAME=deepseek-chat
# 智谱:
#   ETF_AI_API_TYPE=zhipu
#   ETF_AI_MODEL_NAME=glm-4-flash
# Kimi:
#   ETF_AI_API_TYPE=moonshot
#   ETF_AI_MODEL_NAME=moonshot-v1-32k
# DashScope 公网:
#   ETF_AI_API_TYPE=dashscope
#   ETF_AI_MODEL_NAME=qwen-plus
# 自定义兼容接口:
#   ETF_AI_API_TYPE=custom
#   ETF_AI_BASE_URL=https://your-endpoint/v1
#   ETF_AI_MODEL_NAME=your-model-id
